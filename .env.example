# Copy to .env.local and adjust. PROVISIONAL — docforum-core has no
# implemented API yet; this is the assumed local dev port, not a confirmed
# contract. See src/services/api-client.ts.
VITE_API_BASE_URL=http://localhost:4000

# Privacy-preserving analytics (issue #118). Disabled unless set to a
# self-hosted analytics endpoint (Plausible / Umami-compatible). No data is
# collected without this, and the user can opt out via DNT / GPC. See
# src/utils/analytics.ts for the event allowlist and the Privacy page.
# Example: VITE_ANALYTICS_ENDPOINT=https://analytics.example.test
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_DOMAIN=docforum.example.test

# Router mode (issue #119 — ADR 0001). Default is BrowserRouter (clean
# history-API URLs), suitable for any host with server-side rewrite rules.
# Set VITE_USE_HASH_ROUTER=true when deploying to GitHub Pages (or any
# host without rewrites) — the deploy-pages.yml workflow does this
# automatically. Old #/path links keep working in BrowserRouter mode via
# the HashRedirectShim component. See docs/adr/0001-routing-strategy.md.
# VITE_USE_HASH_ROUTER=true
